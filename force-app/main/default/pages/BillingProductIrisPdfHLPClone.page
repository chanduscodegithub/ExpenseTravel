                                </td>
                            </tr>
                            <apex:outputText rendered="{!AcctSeed__Billing__c.HSN_Code__c != null}">
                                <tr>
                                <td>
                                    <apex:outputText value="HSN Code" rendered="{!AcctSeed__Billing__c.HSN_Code__c != null}">
                                        <apex:param value="{!AcctSeed__Billing__c.HSN_Code__c}"/>
                                    </apex:outputText> 
                                </td>
                                <td>
                                    <apex:outputText value="{!AcctSeed__Billing__c.HSN_Code__c}" rendered="{!AcctSeed__Billing__c.HSN_Code__c != null}"/>
                                </td>  
                            </tr>
                            </apex:outputText>
                            
                                                        
                            <!--<tr class="amount-due">
                            <td><apex:outputText value="Amount Due"/></td>
                            <td>
                            <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Balance__c}" rendered="{!!isCurrencyFormat}"/>
                            <apex:outputText value="{!CurrencyFormat}" rendered="{!isCurrencyFormat}">
                            <apex:param value="{!AcctSeed__Billing__c.AcctSeed__Balance__c}"/>
                            </apex:outputText>
                            </td>
                            </tr>-->
                            
                        </table>
                    </td>
                </tr>
