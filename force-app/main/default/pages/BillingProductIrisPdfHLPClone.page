                                    <apex:outputText value="{!$Organization.Street}" rendered="{!ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_Street2__c)}" />
                                    </td></tr>
                                
                                
                               <tr><td>
                                    <apex:outputText value="{!IF(ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_City__c),$Organization.City, AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_City__c) & IF(ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_City__c) && ISBLANK($Organization.City),'',', ') & IF(ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_State__c),$Organization.State,AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_State__c) & ' ' & IF(ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_PostalCode__c),$Organization.PostalCode,AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__Company_PostalCode__c)}" />
                                    </td>
                                </tr>  
                                <tr>
                                    <td>
                                        <apex:outputText value="Off Ph:" rendered="{!officeNumber != null}"/> <apex:outputText label="Off Ph:" value="{!officeNumber}" rendered="{!officeNumber != null}" />
                                    </td>
                          <!--          <td>
                                        <apex:outputText value="{!officeNumber}" />
                                    </td>  -->
                                </tr>
                                <tr><td>
                                    <apex:outputText value="VAT number :" rendered="{!VATNumber != null}"/><apex:outputText label="VAT number :" value="{!VATNumber}" rendered="{!VATNumber != null}" />
                                    </td></tr>
                                <tr><td>
                                    <apex:outputText value="EIN : " rendered="{!EIN != null}"/><apex:outputText label="EIN :" value="{!EIN}" rendered="{!EIN != null}" />
                                    </td></tr>
                                
                                <tr><td>
                                    <apex:outputText value="ABN: " rendered="{!CompanyBusinessNumber != null}"/>
                                    <apex:outputText label="CompanyBusinessNumber :" value="{!CompanyBusinessNumber}" rendered="{!CompanyBusinessNumber != null}" />
                                    </td></tr>
                                <tr><td>
                                    <apex:outputText value="Website:"></apex:outputText>
                                    <apex:outputLink onclick="window.open('https://www.crmit.com/','_blank');">www.crmit.com</apex:outputLink>
                                    
                                    </td></tr> 
                                <tr><td>
                                    <apex:outputText value="Email:" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__ReplyTo_Email__c)}"/><apex:outputText value="{!AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__ReplyTo_Email__c}" rendered="{!!ISBLANK(AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.AcctSeed__ReplyTo_Email__c)}"/>
                                    </td></tr>
                                
                                <tr>
                                    <td style = "padding-top: 5px;">
                                        
                                    </td>
                                </tr>  
                                <tr>
                                    <td>
                                        <apex:outputField value="{!AcctSeed__Billing__c.AcctSeed__Ledger__r.AcctSeed__Default_Billing_Format__r.Company_info__c}"/>
                                    </td>
                                </tr>  
                            </table>        
                        </td>                
                    </tr>
                </table>
            </div>
        
        <!-- SECTION: page numbers repaeating at the bottom of each page -->
        <div class="footer">
            <div style="width:100%; height:1px; background:black;"></div>
            <tr>
                <td width="50%">Page&nbsp;<span class="pagenumber" />&nbsp;of&nbsp;<span class="pagecount" /></td>
                <td width="40%">
                    <center> <apex:outputText value="THANK YOU FOR YOUR BUSINESS!"/></center>
                </td>
            </tr>	
            <div>
                
            </div>
        </div>
        
        <div class="content">
            
            <!-- SECTION: header w/ company address and logo -->
            
